# ---------------------------------------------------------------------------
# JUSTra / RakshaAI — environment variables
# Copy this file to .env.local for local dev, OR paste these keys into the
# Vercel project's Environment Variables screen for deployment.
# Do NOT commit real values — .env.local and .env* are gitignored.
# ---------------------------------------------------------------------------

# --- Supabase (REQUIRED) ----------------------------------------------------
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-side only, grants full DB access. Keep it secret.
# (Do not expose this to the browser / do not prefix with NEXT_PUBLIC_.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Groq AI (REQUIRED) -----------------------------------------------------
# From https://console.groq.com — powers triage, vision, and Nyaya features.
GROQ_API_KEY=your-groq-api-key

# Optional model overrides (code has sensible defaults if omitted):
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- OTP / identity (REQUIRED) ----------------------------------------------
# Any random, hard-to-guess string. Used to salt phone-OTP hashing.
OTP_SALT=change-me-to-a-long-random-string

# Optional: base URL if wiring to a real Aadhaar/KYC service.
# Aadhaar_API_BASE=

# --- Optional: FIR export (app/api/nyaya/fir-export) ------------------------
# Only needed if you use the Word/FIR export feature and pandoc isn't on PATH.
# PANDOC_PATH=

# ---------------------------------------------------------------------------
# NOTE ON FILE UPLOADS IN PRODUCTION
# Evidence uploads are written to public/evidence/ on the local filesystem.
# That works locally but NOT on Vercel (ephemeral/read-only FS). Migrate to
# Supabase Storage before relying on uploads in a deployed environment.
# ---------------------------------------------------------------------------

# --- Optional Python services (NOT used by the Next.js deploy) ---------------
# RAG service (RAG/) — see RAG/READMERAG.md
# RAG_OPENAI_API_KEY=
# RAG_SUPABASE_URL=
# Telegram bot (telegram-bot/)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
